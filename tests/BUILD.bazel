load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Drives the runner directly, as the move_package and move_test actions do,
# through each failure path the rules rely on (see runner_test.sh).
sh_test(
    name = "runner_test",
    size = "medium",
    srcs = ["runner_test.sh"],
    args = [
        "$(rootpath //sui_move:runner.sh)",
        "$(rootpath @sui_cli//:sui)",
        "$(rootpath @move_host_git//:git)",
        "$(rootpath @move_fixture_std//:cache.tar)",
        "$(rootpaths //tests/move_fixture:srcs)",
    ],
    data = [
        "//sui_move:runner.sh",
        "//tests/move_fixture:srcs",
        "@move_fixture_std//:cache.tar",
        "@move_host_git//:git",
        "@sui_cli//:sui",
    ],
    # Runs host git and the host's sui directly.
    tags = [
        "block-network",
        "no-remote",
    ],
)

# move_test must tag itself block-network and no-remote-exec: the fixture's
# move_test sets no tags, so this query is empty unless the macro adds both.
genquery(
    name = "move_test_tags",
    expression = "attr(tags, '\\bblock-network\\b', //tests/move_fixture:move_test) intersect attr(tags, '\\bno-remote-exec\\b', //tests/move_fixture:move_test)",
    scope = ["//tests/move_fixture:move_test"],
)

sh_test(
    name = "move_test_tags_test",
    size = "small",
    srcs = ["move_test_tags_test.sh"],
    args = ["$(rootpath :move_test_tags)"],
    data = [":move_test_tags"],
)
